# Arquivo de configuração das variáveis de ambiente para Edge Functions
# Este arquivo deve ser usado como referência para configurar as variáveis no Supabase Dashboard

# Variáveis necessárias para as Edge Functions:

# SUPABASE_URL - URL do seu projeto Supabase
# Exemplo: https://seu-projeto-id.supabase.co
SUPABASE_URL=your_supabase_project_url

# SUPABASE_ANON_KEY - Chave pública/anônima do Supabase
# Encontre em: Settings > API > Project API keys > anon public
SUPABASE_ANON_KEY=your_supabase_anon_key

# SUPABASE_SERVICE_ROLE_KEY - Chave de serviço do Supabase (privada)
# Encontre em: Settings > API > Project API keys > service_role secret
# ⚠️ CUIDADO: Esta chave deve ser mantida em segredo!
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# Como configurar no Supabase:
# 1. Acesse o Supabase Dashboard
# 2. Vá para seu projeto
# 3. Navegue até Edge Functions
# 4. Clique em "Environment Variables"
# 5. Adicione cada variável acima com seus respectivos valores

# Para desenvolvimento local, você pode usar o arquivo .env.local:
# Copie este arquivo para .env.local e substitua os valores pelos reais
