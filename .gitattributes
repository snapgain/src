# Normalize line endings on commit. All text files use LF in the repo;
# Windows checkouts auto-convert to CRLF in working tree, Mac/Linux stay LF.
* text=auto eol=lf

# Explicit binary types (never touch these)
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.webp binary
*.pdf binary
*.zip binary
*.ttf binary
*.woff binary
*.woff2 binary
